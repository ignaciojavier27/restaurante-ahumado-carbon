---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contacto | Ahumado & Carbón – Brasería de Barrio"
  description="Escríbenos o haz tu reserva en Ahumado & Carbón. Estamos a tu disposición para brindarte la mejor experiencia."
>
  <section id="contacto" class="w-full min-h-screen pt-14 pb-24 relative flex flex-col items-center justify-center">
    <!-- Component Header -->
    <header class="text-center mt-4 mb-16 px-5 sm:px-0 relative flex flex-col items-center justify-center w-full">
      <h1
        class="w-full whitespace-nowrap scale-y-[1.15] origin-center leading-none m-0 p-0 flex justify-center text-accent font-display font-extrabold uppercase"
      >
        <span
          id="contacto-title"
          class="inline-block tracking-[-0.06em] text-[clamp(2rem,8.7vw,10rem)]"
          >Contacto</span
        >
      </h1>
      <p
        class="font-body text-[clamp(0.88rem,1.4vw,1.1rem)] text-foreground opacity-90 max-w-[600px] mx-auto mt-6 mb-6 leading-relaxed [text-shadow:0_2px_8px_rgba(0,0,0,0.6)]"
      >
        ¿Tienes alguna duda o quieres hacer una reserva? Escríbenos y te responderemos a la brevedad para brindarte la mejor experiencia.
      </p>
      <div class="h-1 py-4 w-full relative">
        <div
          class="absolute left-0 right-0 border-b-[4px] border-dotted border-accent pointer-events-none"
        >
        </div>
      </div>
    </header>

    <!-- Contact Form -->
    <div class="w-full max-w-[1200px] xl:max-w-[1400px] mx-auto px-4 sm:px-8">
      <form id="whatsapp-form" class="w-full max-w-3xl mx-auto flex flex-col gap-6 p-6 sm:p-10 rounded-lg shadow-2xl border border-accent/20 bg-black/40 backdrop-blur-md">
        <div class="flex flex-col sm:flex-row gap-6">
          <div class="flex-1">
            <label for="name" class="block text-sm font-body text-foreground/90 mb-2 font-semibold tracking-wide uppercase">Nombre Completo *</label>
            <input 
              type="text" 
              id="name" 
              required 
              class="w-full bg-black/60 border border-accent/40 rounded-md px-4 py-3.5 text-foreground font-body focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all placeholder:text-foreground/30" 
              placeholder="Ej: Juan Pérez" 
            />
          </div>
          <div class="flex-1">
            <label for="phone" class="block text-sm font-body text-foreground/90 mb-2 font-semibold tracking-wide uppercase">Teléfono *</label>
            <input 
              type="tel" 
              id="phone" 
              required 
              class="w-full bg-black/60 border border-accent/40 rounded-md px-4 py-3.5 text-foreground font-body focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all placeholder:text-foreground/30" 
              placeholder="Ej: +34 600 000 000" 
            />
          </div>
        </div>
        <div>
          <label for="message" class="block text-sm font-body text-foreground/90 mb-2 font-semibold tracking-wide uppercase">Tu Mensaje *</label>
          <textarea 
            id="message" 
            required 
            rows="6" 
            class="w-full bg-black/60 border border-accent/40 rounded-md px-4 py-3.5 text-foreground font-body focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all resize-none placeholder:text-foreground/30" 
            placeholder="¿En qué podemos ayudarte? ¿Quieres reservar una mesa?"
          ></textarea>
        </div>
        <button 
          type="submit" 
          class="bg-accent hover:bg-accent/90 text-white font-display font-bold uppercase tracking-wider py-4 rounded-md transition-colors mt-4 text-lg shadow-[0_0_15px_rgba(203,50,51,0.4)] hover:shadow-[0_0_25px_rgba(203,50,51,0.6)] flex items-center justify-center gap-3 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          Enviar mensaje
        </button>
      </form>
    </div>
  </section>
</Layout>

<script>
  /* ─── Title auto-fit ─── */
  function adjustContactoTitle() {
    const span = document.getElementById("contacto-title");
    const h1 = span?.parentElement;
    if (!span || !h1) return;
    
    const maxWidth = h1.clientWidth;
    if (maxWidth <= 0) return;
    
    let min = 12, max = 160, optimal = min;
    for (let i = 0; i < 10; i++) {
      const mid = Math.floor((min + max) / 2);
      span.style.fontSize = mid + "px";
      if (span.offsetWidth <= maxWidth) { 
        optimal = mid; 
        min = mid + 1; 
      } else { 
        max = mid - 1; 
      }
    }
    span.style.fontSize = optimal + "px";
  }
  
  window.addEventListener("resize", adjustContactoTitle);
  document.fonts.ready.then(adjustContactoTitle);
  document.addEventListener("astro:page-load", adjustContactoTitle);
  adjustContactoTitle();

  /* ─── WhatsApp Form Submission ─── */
  function initWhatsAppForm() {
    const form = document.getElementById('whatsapp-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const nameInput = document.getElementById('name') as HTMLInputElement;
      const phoneInput = document.getElementById('phone') as HTMLInputElement;
      const messageInput = document.getElementById('message') as HTMLTextAreaElement;

      // Sanitización de inputs para evitar inyección o caracteres raros en la URL
      const sanitize = (str: string) => {
        return str.trim()
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#x27;");
      };

      const name = sanitize(nameInput.value);
      const phone = sanitize(phoneInput.value);
      const message = sanitize(messageInput.value);

      if (!name || !phone || !message) {
        return;
      }

      // Número ficticio de WhatsApp (Formato internacional sin el +)
      const whatsappNumber = "5491112345678"; 
      
      const text = `*Nuevo Mensaje desde la Web*\n\n*👤 Nombre:* ${name}\n*📱 Teléfono:* ${phone}\n\n*📝 Mensaje:*\n${message}`;
      
      const encodedText = encodeURIComponent(text);
      const url = `https://wa.me/${whatsappNumber}?text=${encodedText}`;
      
      window.open(url, '_blank');
    });
  }

  initWhatsAppForm();
  document.addEventListener("astro:page-load", initWhatsAppForm);
</script>
