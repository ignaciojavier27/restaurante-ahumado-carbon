---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

// Import Gallery Images dynamically
const imagesGlob = import.meta.glob<{ default: any }>('../assets/images/galeria/**/*.{jpeg,jpg,png,gif,webp}');
const imagePaths = Object.keys(imagesGlob);

// Descriptive alt text labels for gallery SEO
const altLabels: Record<number, string> = {
	0: "Plato estrella de Ahumado & Carbón: carne premium a la parrilla",
	1: "Interior del restaurante Ahumado & Carbón con ambiente rústico",
	2: "Detalle de la parrilla y las brasas de Ahumado & Carbón",
	3: "Hamburguesa artesanal servida en Ahumado & Carbón",
	4: "Mesa preparada en Ahumado & Carbón, brasería de barrio",
	5: "Costillas ahumadas, especialidad de la casa en Ahumado & Carbón",
	6: "Ambiente nocturno en Ahumado & Carbón, Santiago",
	7: "Corte de carne premium sobre las brasas en Ahumado & Carbón",
	8: "Entrantes y compartibles en Ahumado & Carbón",
	9: "Coctelería artesanal en Ahumado & Carbón",
	10: "Detalles del menú en la brasería Ahumado & Carbón",
	11: "Visita y ambiente de la brasería Ahumado & Carbón",
};

const galleryJsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "ImageGallery",
	"@id": "https://ahumadoycarbon.cl/galeria#gallery",
	name: "Galería Ahumado & Carbón",
	description: "Fotos del restaurante Ahumado & Carbón: platos, ambiente y detalles de la brasería de barrio en Santiago.",
	url: "https://ahumadoycarbon.cl/galeria",
	isPartOf: { "@id": "https://ahumadoycarbon.cl/#restaurant" },
});

const breadcrumbJsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Inicio", item: "https://ahumadoycarbon.cl" },
		{ "@type": "ListItem", position: 2, name: "Galería", item: "https://ahumadoycarbon.cl/galeria" },
	],
});
---

<Layout
  canonicalPath="/galeria"
  title="Galería | Ahumado & Carbón – Brasería de Barrio"
  description="Explora nuestra galería de imágenes. Conoce nuestros platos, el ambiente y los detalles que hacen de Ahumado & Carbón un lugar único en Santiago."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={galleryJsonLd} />
    <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  </Fragment>
  <section id="galeria" class="w-full min-h-screen pt-14 pb-24 relative">
    <!-- Page heading -->
    <header class="text-center mt-4 mb-16 px-5 sm:px-0 relative flex flex-col items-center justify-center w-full">
      <h1
        class="w-full whitespace-nowrap scale-y-[1.15] origin-center leading-none m-0 p-0 flex justify-center text-accent font-display font-extrabold uppercase"
      >
        <span
          id="galeria-title"
          class="inline-block tracking-[-0.06em] text-[clamp(2rem,8.7vw,10rem)]"
          >Galería</span
        >
      </h1>
      <p
        class="font-body text-[clamp(0.88rem,1.4vw,1.1rem)] text-foreground opacity-90 max-w-[600px] mx-auto mt-6 mb-6 leading-relaxed [text-shadow:0_2px_8px_rgba(0,0,0,0.6)]"
      >
        Momentos, platos y el ambiente que define nuestra brasería.
      </p>
      <div class="h-1 py-4 w-full relative">
        <div
          class="absolute left-0 right-0 border-b-[4px] border-dotted border-accent pointer-events-none"
        >
        </div>
      </div>
    </header>

    <!-- Gallery Grid -->
    <div class="w-full max-w-[1200px] xl:max-w-[1400px] mx-auto px-4 sm:px-8 pb-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {imagePaths.map((path, index) => (
          <div class="item-img-wrap js-reveal">
            <Image
              src={imagesGlob[path]()}
              alt={altLabels[index] ?? `Foto del restaurante Ahumado & Carbón número ${index + 1}`}
              class="item-img"
              loading={index < 8 ? "eager" : "lazy"}
              widths={[300, 600]}
              sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Image Frame Style ─── */
  .item-img-wrap {
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(203, 50, 51, 0.4);
    padding: 0.35rem;
    background: rgba(0, 0, 0, 0.15);
  }

  .item-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 2px;
  }

  /* ─── Reveal animation (JS-driven) ─── */
  .js-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .js-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  /* ─── Title auto-fit ─── */
  function adjustTitle() {
    const span = document.getElementById("galeria-title");
    const h1 = span?.parentElement;
    if (!span || !h1) return;
    const maxWidth = h1.clientWidth;
    if (maxWidth <= 0) return;
    let min = 12, max = 160, optimal = min;
    for (let i = 0; i < 10; i++) {
      const mid = Math.floor((min + max) / 2);
      span.style.fontSize = mid + "px";
      if (span.offsetWidth <= maxWidth) { optimal = mid; min = mid + 1; }
      else { max = mid - 1; }
    }
    span.style.fontSize = optimal + "px";
  }
  window.addEventListener("resize", adjustTitle);
  document.fonts.ready.then(adjustTitle);
  document.addEventListener("astro:page-load", adjustTitle);
  adjustTitle();

  /* ─── Intersection Observer for scroll-up reveal ─── */
  function initReveal() {
    const items = document.querySelectorAll<HTMLElement>(".js-reveal");
    if (!items.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            // Se mantiene visible una vez revelado
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -20px 0px",
      }
    );

    items.forEach((el) => observer.observe(el));
  }

  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
