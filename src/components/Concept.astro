---
import { Image } from "astro:assets";
import carneImage from "../assets/images/home-images/carne.jpg";
import parrillaImage from "../assets/images/home-images/parrilla.jpg";
import parrillaDosImage from "../assets/images/home-images/parrilla-2.jpg";
import vinoImage from "../assets/images/home-images/vino.jpg";
import Button from "./Button.astro";
---

<section
  id="concepto"
  class="relative w-full py-8 md:py-16 px-4 md:px-8 max-w-7xl mx-auto overflow-hidden"
>
  <!-- Frase Destacada -->
  <div class="max-w-4xl mx-auto text-center mb-16 md:mb-20">
    <div class="flex items-center justify-center gap-3 mb-8">
      <span class="h-[1px] w-12 bg-accent/30"></span>
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      <span class="h-[1px] w-12 bg-accent/30"></span>
    </div>

    <p
      class="concept-text text-foreground font-body leading-relaxed tracking-wide"
    >
      "El aroma a leña, el sonido de las brasas y el sabor que solo el fuego
      real puede entregar. Traemos carnes de cocción lenta, hamburguesas con
      carácter y una experiencia hecha para disfrutar, con las manos, entre
      amigos y con ganas de repetir."
    </p>

    <div class="flex items-center justify-center gap-3 mt-8">
      <span class="h-[1px] w-8 bg-accent/30"></span>
      <span
        class="text-accent text-xs tracking-[0.3em] uppercase font-bold font-display opacity-80"
        >Experiencia Rústica</span
      >
      <span class="h-[1px] w-8 bg-accent/30"></span>
    </div>
  </div>

  <!-- Galería de 3 Imágenes en Fila con Rotación y Overlap -->
  <div
    class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar md:overflow-visible md:snap-none md:flex-row items-center md:justify-center gap-6 md:gap-0 md:-space-x-6 w-full max-w-5xl mx-auto px-4 mt-8 pb-8 md:pb-0"
  >
    <!-- Card 1: Parrilla (Izquierda) -->
    <div
      class="image-card card-left group w-[80vw] sm:w-[60vw] md:w-[310px] shrink-0 snap-center md:snap-align-none"
    >
      <div class="image-container">
        <Image
          src={parrillaImage}
          alt="Brasas y parrilla en acción"
          class="concept-image"
        />
        <div class="image-overlay"></div>
      </div>
    </div>

    <!-- Card 2: Carne (Centro) -->
    <div
      class="image-card card-middle group w-[80vw] sm:w-[60vw] md:w-[310px] shrink-0 snap-center md:snap-align-none"
    >
      <div class="image-container">
        <Image
          src={carneImage}
          alt="Nuestras carnes premium de cocción lenta"
          class="concept-image"
        />
        <div class="image-overlay"></div>
      </div>
    </div>

    <!-- Card 3: Vino (Derecha) -->
    <div
      class="image-card card-right group w-[80vw] sm:w-[60vw] md:w-[310px] shrink-0 snap-center md:snap-align-none"
    >
      <div class="image-container">
        <Image
          src={vinoImage}
          alt="Maridaje perfecto y coctelería"
          class="concept-image"
        />
        <div class="image-overlay"></div>
      </div>
    </div>

    <!-- Card 4: Parrilla Dos  (Derecha) -->
    <div
      class="image-card card-right group w-[80vw] sm:w-[60vw] md:w-[310px] shrink-0 snap-center md:snap-align-none"
    >
      <div class="image-container">
        <Image
          src={parrillaDosImage}
          alt="Maridaje perfecto y coctelería"
          class="concept-image"
        />
        <div class="image-overlay"></div>
      </div>
    </div>
  </div>
  <!-- Botón CTA: Reservar -->
  <div class="mt-16 flex justify-center w-full relative z-20">
    <Button href="#reservas" data-modal="reservation">Reservar</Button>
  </div>
</section>

<style>
  .concept-text {
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    font-weight: 500;
    font-style: italic;
    opacity: 0.95;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .image-card {
    position: relative;
    padding: 0.5rem;
    border: 1px solid rgba(203, 50, 51, 0.12); /* accent/12 */
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(8px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Rotaciones iniciales y profundidad (Z-Index) */
  .card-left {
    transform: rotate(-3.5deg);
    z-index: 1;
  }

  .card-middle {
    transform: rotate(2deg);
    z-index: 2; /* Queda sobre las dos laterales */
  }

  .card-right {
    transform: rotate(-3deg);
    z-index: 1;
  }

  /* Animación al pasar el mouse: se endereza, escala y sube a primer plano */
  .image-card:hover {
    border-color: rgba(203, 50, 51, 0.35); /* accent/35 */
    z-index: 10 !important;
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 20px rgba(203, 50, 51, 0.15);
  }

  .image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .concept-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 13, 13, 0.4), transparent);
    opacity: 0.8;
    transition: opacity 0.4s ease;
  }

  .image-card:hover .concept-image {
    transform: scale(1.03);
  }

  .image-card:hover .image-overlay {
    opacity: 0.5;
  }

  /* Ocultar barra de scroll en carrusel móvil */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
